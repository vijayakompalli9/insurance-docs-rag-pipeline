# Copy to .env and fill in ONLY if you switch away from the offline defaults.
# Never commit .env.
RAG_CONFIG=config.yaml
RAG_EMBEDDING_PROVIDER=local
RAG_GENERATOR_PROVIDER=extractive

# AWS Bedrock (credentials resolved by the standard boto3 chain: env, profile, or IAM role)
AWS_REGION=us-east-1
# AWS_PROFILE=your-profile-name

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
